# Copy to .env and fill in. `source .env` before every run.

# Agent: Claude Code subscription OAuth token (requires a Claude Max subscription).
# Refresh before every session — see "Before each run" in the README.
export CLAUDE_CODE_OAUTH_TOKEN=$(~/.local/bin/claude-token)

# Judge: Anthropic API key for the rubric verifier (OpenAI-compatible endpoint).
export OPENAI_API_KEY=<your-anthropic-api-key>
export OPENAI_API_BASE=https://api.anthropic.com/v1
export EVAL_MODEL=claude-opus-4-5-20251101
